{
  "name": "starry-manual",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3210",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "node scripts/preview-pages.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3210",
    "typecheck": "next typegen && tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "test:blueprint": "node --test tests/blueprint-navigation.test.mjs tests/blueprint-layout.test.mjs",
    "test:graph": "node --test tests/knowledge-graph.test.mjs",
    "test:navigation": "node --test tests/navigation.test.mjs",
    "test:diagram": "node --test tests/diagram-viewport.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@keystatic/core": "0.6.9",
    "@keystatic/next": "5.0.5",
    "@markdoc/markdoc": "^0.5.4",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@xyflow/react": "12.12.0",
    "d3-force": "3.0.0",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.5",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.577.0",
    "mermaid": "12.2.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-force": "3.0.10",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "postcss": "^8.5.6",
    "prettier": "3.8.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
